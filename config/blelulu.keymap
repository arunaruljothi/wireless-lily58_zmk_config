 *
 * Layout ported from the ZSA Voyager "a_main" (Oryx) layout.
 * Layers: 0 main, 1 sym, 2 nav/fn (includes Bluetooth + Studio unlock keys)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MEH LS(LC(LALT))
#define HYPER LS(LC(LA(LGUI)))

/* Key positions (58-key Lulu), used for opposite-hand home-row mods */

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49
#define THUMBS 42 43 50 51 52 53 54 55 56 57

/ {
    behaviors {
        // Left-hand home-row mod: only holds when another key (right hand/thumb) is pressed

        hml: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";                // ~ QMK permissive hold
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;      // ~ QMK flow tap (100ms)
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Right-hand home-row mod

        hmr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Voyager per-key tapping term: ' = 120ms

        hmr_q: homerow_right_quote {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "Main";
            bindings = <
&kp LG(SPACE)   &kp N1        &kp N2       &kp N3       &kp N4        &kp N5                     &kp N6    &kp N7        &kp N8       &kp N9       &kp N0            &studio_unlock
&kp LEFT_SHIFT  &kp Q         &kp W        &kp E        &kp R         &kp T                      &kp Y     &kp U         &kp I        &kp O        &kp P             &msc SCRL_UP
&kp ESCAPE      &hml LSHFT A  &hml LALT S  &hml LGUI D  &hml LCTRL F  &kp G                      &kp H     &hmr RCTRL J  &hmr RGUI K  &hmr RALT L  &hmr_q RSHFT SQT  &msc SCRL_DOWN
&kp TAB         &kp Z         &kp X        &kp C        &kp V         &kp B      &none    &none  &kp N     &kp M         &kp COMMA    &kp DOT      &kp RET           &kp RIGHT_ALT
                                           &none        &kp MEH       &kp SPACE  &mo 2    &sl 1  &kp BSPC  &kp HYPER     &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
&none  &none      &none     &none           &none      &none                      &none      &none     &none      &none      &none      &none
&none  &kp EXCL   &kp AT    &kp HASH        &kp DLLR   &kp PRCNT                  &kp CARET  &kp AMPS  &kp ASTRK  &kp COLON  &kp SEMI   &none
&none  &kp TILDE  &kp PIPE  &kp EQUAL       &kp MINUS  &kp PLUS                   &kp LBRC   &kp RBRC  &kp LPAR   &kp RPAR   &kp DQT    &none
&none  &kp GRAVE  &kp BSLH  &kp FSLH        &kp UNDER  &none      &none    &none  &kp LBKT   &kp RBKT  &kp LT     &kp GT     &kp QMARK  &none
                            &bt BT_CLR_ALL  &none      &none      &none    &to 0  &none      &none     &none
            >;
        };

        nav_fn {
            display-name = "Nav";
            bindings = <
&none   &kp F1        &kp F2        &kp F3          &kp F4        &kp F5                        &kp F6    &kp F7      &kp F8        &kp F9        &kp F10         &none
&tog 2  &kp C_BRI_DN  &kp C_BRI_UP  &studio_unlock  &none         &trans                        &none     &kp C_PREV  &kp C_PP      &kp C_NEXT    &none           &none
&trans  &trans        &trans        &trans          &trans        &trans                        &kp LEFT  &kp DOWN    &kp UP        &kp RIGHT     &mt HOME PG_UP  &msc SCRL_UP
&none   &mkp MB4      &mkp MB5      &mkp RCLK       &mkp LCLK     &mkp MCLK     &none    &none  &mkp MB5  &none       &kp C_VOL_DN  &kp C_VOL_UP  &mt END PG_DN   &msc SCRL_DOWN
                                    &bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &none    &none  &kp DEL   &none       &none
            >;
        };
    };
};
